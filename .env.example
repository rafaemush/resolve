# ============================================================
# Resolve — environment variables
# Copy to .env for local tooling (evals, scripts) and to .dev.vars for
# `wrangler dev`. In production every secret is set with `wrangler secret put`.
# Non-secret config lives in wrangler.toml [vars]. NEVER commit .env/.dev.vars.
# ============================================================

# --- TypeSafe / Jev ------------------------------------------------------
TYPESAFE_API_KEY=                 # apikey_... (early access). Rotate the 2026-09-19 pilot key.
JEV_MODEL=jev-1.13.0              # pinned; thresholds_version moves with it. Never a literal in code.
JEV_RPM_LIMIT=1200                # from docs.typesafe.ai/models (dynamic); overwrite from TypeSafe's written Order terms.
JEV_USD_PER_MTOK=0.042            # input price; output is free. Unknown model id bills at 100x this.
JEV_TIMEOUT_MS=2500
JEV_PAID_ROUTES_ENABLED=0         # "1" only after TypeSafe confirms commercial early-access use in writing (plan §3.7)
JEV_DAILY_USD_CEILING=1.00        # global daily spend ceiling; over it Jev routes return UPSTREAM_UNAVAILABLE/BUDGET_EXCEEDED

# --- Resolution thresholds (defaults in src/resolve/thresholds.ts) -------
THRESHOLDS_VERSION=v1
SPOTLIGHT_SECRET=                 # 32+ random bytes hex; evidence delimiter = HMAC(secret, canonical_sha256). Eval mode uses a fixed constant.

# --- Supabase (new Free org "Resolve", project resolve-prod, us-east-1) --
SUPABASE_PROJECT_REF=
SUPABASE_ORG_SLUG=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # Worker secret only; never in GitHub Actions
SUPABASE_DB_PASSWORD=             # for `supabase db push` / pg_dump backups

# --- Internal auth -------------------------------------------------------
INTERNAL_HMAC_SECRET=             # pg_net -> /internal/watch/:id signature (also stored in Supabase Vault)
ADMIN_API_KEY=                    # /internal/bench and admin-only routes
EVAL_REPORT_KEY=                  # scoped insert-only key for /internal/eval-report (the only DB-touching secret GitHub Actions holds)

# --- Ingestion sources ---------------------------------------------------
GITHUB_TOKEN=                     # NEW fine-grained PAT, public repos read-only. Never reuse OilFlow's leaked classic PAT.
ALCHEMY_BASE_HTTP_URL=            # https://base-mainnet.g.alchemy.com/v2/<key>  (Free: ~30M CU/mo)
BASE_FALLBACK_HTTP_URL=https://mainnet.base.org
HELIUS_API_KEY=                   # Solana (Free: 1M credits/mo, 10 rps)
SOLANA_FALLBACK_HTTP_URL=https://api.mainnet-beta.solana.com
LIMITLESS_API_KEY=                # lmts_... (free, from limitless.exchange)
RESOLVE_BOT_UA=ResolveBot/1.0 (+https://resolve.example/bot)

# --- Billing (USDC on Base) ---------------------------------------------
USDC_BASE_CONTRACT=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
USDC_RECEIVING_ADDRESS=           # fresh EOA generated offline; only the ADDRESS lives on any server
CREDITS_PER_USDC=100              # 1 credit = $0.01

# --- Settle-bot / track record ------------------------------------------
TELEGRAM_BOT_TOKEN=               # NEW bot from BotFather (not OilFlow's)
TELEGRAM_CHANNEL_ID=              # public channel the bot administers
TELEGRAM_OPERATOR_CHAT_ID=        # founder DM for alerts

# --- Platform -------------------------------------------------------------
RESOLVE_PUBLIC_URL=               # https://resolve.<your-subdomain>.workers.dev or custom domain
SCHEMA_VERSION=1

# --- Evals ---------------------------------------------------------------
EVAL_LIVE=0                       # "1" lets evals/run.ts call Jev for real (cost-capped)
EVAL_MAX_COST_USD=0.05
