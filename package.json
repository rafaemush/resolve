{
  "name": "resolve",
  "version": "0.1.0",
  "private": true,
  "description": "Resolve — automated resolution infrastructure API for long-tail prediction markets (Cloudflare Workers + Supabase + TypeSafe Jev)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "bash scripts/deploy.sh",
    "deploy:dry": "DRY_RUN=1 bash scripts/deploy.sh",
    "deploy:raw": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx evals/run.ts",
    "eval:build": "tsx evals/build.ts",
    "eval:mutate": "tsx evals/mutate.ts",
    "eval:ingest": "tsx evals/ingest.ts",
    "eval:official": "tsx evals/official.ts",
    "eval:registration": "tsx evals/registration.ts",
    "eval:reveal": "tsx evals/reveal.ts",
    "eval:inline": "tsx evals/inline.ts",
    "openapi": "tsx scripts/openapi.ts",
    "migrate": "tsx scripts/migrate.ts",
    "selftest:db": "tsx scripts/selftest-db.ts",
    "selftest:dispatch": "tsx scripts/selftest/dispatch.ts",
    "configure:db": "tsx scripts/configure-db.ts",
    "candidates": "tsx scripts/candidates.ts",
    "seed:shadow": "tsx scripts/seed-shadow.ts",
    "test-key": "tsx scripts/issue-test-key.ts",
    "touch": "tsx scripts/log-touch.ts",
    "leads": "tsx scripts/leads.ts",
    "venue:report": "tsx scripts/venue-report.ts",
    "wallet:gen": "tsx scripts/gen-wallet.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.0",
    "hono": "^4.13.8",
    "viem": "^2.56.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260922.1",
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "wrangler": "^4.136.2"
  }
}
